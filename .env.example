# ─────────────────────────────────────────────────────────────────────────────
# MUBAZZAR environment variables
# Everything is optional for local development: without keys the app uses
# PGlite (local Postgres) and mock adapters that record to the database outbox.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs session cookies. REQUIRED in production: 32+ random characters (the server refuses to sign
# sessions without it). Generate with: openssl rand -base64 48
AUTH_SECRET=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). REQUIRED in production.
CRON_SECRET=

# Salt for hashing customer IPs before storing (privacy). REQUIRED in production: 16+ random characters.
IP_HASH_SALT=

# Optional anti-abuse tuning (defaults shown). Per-phone open-order caps live in admin settings.
# ORDER_RATE_PER_IP=10        # orders per IP per 10 minutes
# ORDER_MAX_OPEN_PER_IP=8     # unpaid open orders one IP may hold

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase Postgres connection string (Transaction pooler, port 6543). When unset, PGlite is used.
DATABASE_URL=
# Optional: PGlite data directory for local dev (default .data/pglite)
PGLITE_DATA_DIR=
DATABASE_POOL_MAX=5

# ── Supabase (Auth + Storage) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta Pixel + Conversions API ─────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional while testing in Events Manager
META_TEST_EVENT_CODE=

# ── Notifications ───────────────────────────────────────────────────────────
# Email via Resend (https://resend.com) - Free tier includes 3,000 emails/month
RESEND_API_KEY=
EMAIL_FROM="MUBAZZAR <orders@mubazzar.ng>"
# Optional WhatsApp Cloud API for automated status updates (customer chat still uses wa.me links)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# ── Development only ────────────────────────────────────────────────────────
# Fixed OTP code for the mock auth adapter (ignored in production)
MOCK_OTP_CODE=

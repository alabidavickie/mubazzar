# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# local data (PGlite, uploads)
/.data/

# test output
/test-results/
/reports/playwright/
/playwright-report/
/.lighthouseci/

# agent worktrees
/.claude/worktrees/

# Desktop E2E screenshots are regenerated every run; only the mobile ones are kept for design review
tests/screenshots/*-desktop.png

# Test/Lighthouse run output (the final Lighthouse report is committed deliberately at release)
reports/playwright/
reports/lighthouse/

# Generated by pnpm db:seed-sql
supabase/seed.sql
supabase/seed.production.sql
